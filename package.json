{
  "name": "@tevm/chains",
  "version": "0.0.2",
  "description": "Blockchain chain constants for TypeScript, Zig and Go",
  "main": "src/chains.js",
  "module": "src/chains.js",
  "types": "src/chains.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/chains.d.ts",
      "default": "./src/chains.js"
    }
  },
  "files": [
    "src/chains.js",
    "src/chains.d.ts",
    "src/chains.ts",
    "LICENSE.chainlist"
  ],
  "scripts": {
    "update-chainlist": "bun scripts/update-chainlist.ts",
    "generate": "bun scripts/generate.ts",
    "check:generated": "bun run generate --check",
    "lint": "prettier --check README.md CLAUDE.md index.ts package.json \"tsconfig*.json\" .github/workflows scripts tests",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test tests/unit.test.ts",
    "test:property": "bun test tests/property.test.ts",
    "test:e2e": "bun tests/e2e.ts",
    "bench": "bun tests/bench.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.1"
}
